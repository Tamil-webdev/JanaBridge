APP_NAME=JanaBridge
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./data/janabridge.db
VECTOR_DB_DIR=./data/vector_store
DOCUMENT_DIR=./data/documents
OLLAMA_BASE_URL=http://localhost:11434
# Generation model for chatbot responses (must be installed in Ollama)
CHAT_MODEL=qwen3.5:0.8b
GENERATION_MODEL=qwen3.5:0.8b
# Embedding model for document/query vectorization (must be installed in Ollama)
# WARNING: Do NOT change this after indexing documents without re-indexing.
EMBEDDING_MODEL=qwen3-embedding:0.6b
REQUEST_TIMEOUT=180
MAX_UPLOAD_SIZE_MB=10
MAX_RETRIEVED_PASSAGES=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_EVIDENCE_THRESHOLD=0.5
